{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFProDataFactory8023"
		},
		"ls_azure_data_lake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_azure_data_lake'"
		},
		"ls_azure_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azure_sql'"
		},
		"ls_REST_API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"ls_azure_data_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfprostorage8023.dfs.core.windows.net/"
		},
		"ls_azure_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-pro-server-8023.database.windows.net"
		},
		"ls_azure_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adfprodb"
		},
		"ls_azure_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminadmin"
		},
		"ScheduleTrigger_properties_Schedule_parameters_schema": {
			"type": "string",
			"defaultValue": "source"
		},
		"ScheduleTrigger_properties_Schedule_parameters_table": {
			"type": "string",
			"defaultValue": "Orders"
		},
		"ScheduleTrigger_properties_Schedule_parameters_back_date": {
			"type": "string",
			"defaultValue": "''"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFProDataFactory8023_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azure_data_lake_accountKey": {
						"value": "[parameters('ls_azure_data_lake_accountKey')]"
					},
					"ls_azure_sql_password": {
						"value": "[parameters('ls_azure_sql_password')]"
					},
					"ls_REST_API_properties_typeProperties_url": {
						"value": "[parameters('ls_REST_API_properties_typeProperties_url')]"
					},
					"ls_azure_data_lake_properties_typeProperties_url": {
						"value": "[parameters('ls_azure_data_lake_properties_typeProperties_url')]"
					},
					"ls_azure_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_server')]"
					},
					"ls_azure_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_database')]"
					},
					"ls_azure_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_userName')]"
					},
					"ScheduleTrigger_properties_Schedule_parameters_schema": {
						"value": "[parameters('ScheduleTrigger_properties_Schedule_parameters_schema')]"
					},
					"ScheduleTrigger_properties_Schedule_parameters_table": {
						"value": "[parameters('ScheduleTrigger_properties_Schedule_parameters_table')]"
					},
					"ScheduleTrigger_properties_Schedule_parameters_back_date": {
						"value": "[parameters('ScheduleTrigger_properties_Schedule_parameters_back_date')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}